generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LocalAdmin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  // "admin"：可管理其他用户与限流；"user"：只能管理自己的订阅/模板。
  // 默认 admin 让首个（setup）账号及历史单管理员记录迁移后无缝成为管理员。
  role         String    @default("admin")
  // 非空表示账户被禁用：禁止登录，且 getCurrentAdmin 视其为未登录。
  disabledAt   DateTime?

  // 每用户配额（null = 用全局默认/不限）。
  maxSubscriptions        Int?
  maxNodesPerSubscription Int?
  // 拉取限流阈值（null = 用全局默认）：窗口内最大次数 / 窗口秒数 / 超限冷却秒数。
  pullRateLimitMax        Int?
  pullRateWindowSeconds   Int?
  pullCooldownSeconds     Int?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  subscriptions Subscription[]
  templates      LocalTemplate[]
}

model LocalTemplate {
  id              String   @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  encryptedConfig String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner LocalAdmin @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([updatedAt])
}

model Subscription {
  id                            String    @id @default(cuid())
  ownerId                       String
  name                          String
  token                         String    @unique @default(cuid())
  isPrimary                     Boolean   @default(false)
  encryptedUrls                 String    @db.Text
  encryptedNodes                String    @db.Text
  encryptedConfig               String    @db.Text
  encryptedSubscriptionInfo     String?   @db.Text
  autoUpdateInterval            Int?
  cacheExpiresAt                DateTime?
  lastAccessedAt                DateTime?
  lastUpdatedAt                 DateTime?

  // 拉取（config.yaml）限流运行态：固定窗口计数 + 冷却到期时间。
  pullWindowStartedAt           DateTime?
  pullCountInWindow             Int       @default(0)
  pullThrottledUntil            DateTime?
  pullThrottleTrippedAt         DateTime?
  // 手动刷新限流运行态（独立窗口）。
  refreshWindowStartedAt        DateTime?
  refreshCountInWindow          Int       @default(0)
  refreshThrottledUntil         DateTime?

  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  owner           LocalAdmin                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  autoUpdateState SubscriptionAutoUpdateState?

  @@index([ownerId])
  @@index([lastUpdatedAt])
  @@index([pullThrottledUntil])
}

model SubscriptionAutoUpdateState {
  subscriptionId           String    @id
  externalFailureCount     Int       @default(0)
  failureSourceState       String?   @db.Text
  lastFailedAt             DateTime?
  lastAttemptedAt          DateTime?
  disabledAt               DateTime?
  disabledReason           String?
  disabledPreviousInterval Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// 单例全局设置（固定一行 id="global"）。
model LocalSetting {
  id                             String   @id @default("global")
  // 开启后：客户端拉取 config.yaml 时，若距上次刷新超过最小间隔，则先去上游刷新再返回最新。
  forceRefreshOnFetch            Boolean  @default(false)
  forceRefreshMinIntervalSeconds Int      @default(600)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}
